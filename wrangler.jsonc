{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker name must match the project name in the Cloudflare dashboard.
  "name": "website-business",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    // Static files: /_next/static, /public and the prerendered pages (cache headers in public/_headers).
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Keep variables set in the Cloudflare dashboard (e.g. MAIL_FROM, INQUIRY_TO_EMAIL)
  // when a new version is deployed from Git. Secrets are always kept.
  "keep_vars": true,
  "observability": { "enabled": true }
}
