# Copy to .env.local (development) or set in your hosting provider's dashboard.
# Never commit real values.

# ---------------------------------------------------------------- Site
# Public URL of the site, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---------------------------------------------------------------- Inquiry emails (pick ONE provider)
# Where new project inquiries are delivered. Defaults to the contact email in src/config/site.ts.
INQUIRY_TO_EMAIL=hello@example.com
# Sender shown on outgoing emails. Must be an address on a domain you've verified with your provider.
MAIL_FROM="Fusion Sites <no-reply@example.com>"

# Option A — Resend (recommended): https://resend.com
RESEND_API_KEY=

# Option B — any SMTP server (Google Workspace, Microsoft 365, Zoho, Mailgun, …)
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); leave empty to infer from the port
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Optional: force a provider ("resend" | "smtp" | "console"). "console" only logs
# emails and only works outside production — handy for local development.
MAIL_PROVIDER=

# Send the customer an acknowledgement email in their language (default: true).
SEND_CUSTOMER_CONFIRMATION=true

# Optional second delivery channel: every inquiry is also POSTed as JSON here
# (Slack/Teams incoming webhook, Zapier, Make, n8n…). Must be HTTPS.
INQUIRY_WEBHOOK_URL=

# Max inquiries per IP address per 15 minutes (default: 5).
INQUIRY_RATE_LIMIT=5

# ---------------------------------------------------------------- Scheduling (optional)
# Your Calendly event link. When set, the confirmation screen lets customers book
# a confirmed slot right away. Example: https://calendly.com/your-team/intro-call
NEXT_PUBLIC_CALENDLY_URL=

# ---------------------------------------------------------------- Spam protection (optional)
# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
